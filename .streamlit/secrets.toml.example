# Streamlit Secrets Template for User Feedback Discovery Engine
#
# The app reads GEMINI_API_KEY from the server environment first, then from
# this file. The key is used only for server-side API calls and is never sent
# to the browser.
#
# Locally, prefer an environment variable:
#   export GEMINI_API_KEY="your-key-here"
#
# On Streamlit Community Cloud, add the line below under
# App settings -> Secrets.

GEMINI_API_KEY = "your-google-gemini-api-key-here"
